        </aliases>
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_0468975230382081]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TotalAmount])' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_0468975230529538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TotalAmount])/COUNT([InvoiceNo])' />
      </column>
      <column caption='Month-Year' datatype='string' name='[Calculation_0468975230828547]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;,[date]) + &quot; &quot; + STR(YEAR([date]))' />
      </column>
      <column caption='Customer Lifetime Value ' datatype='real' name='[Calculation_0468975232471044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_key]:SUM([TotalAmount])}' />
      </column>
      <column caption='% of Total Revenue' datatype='real' name='[Calculation_0468975233863688]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TotalAmount])/TOTAL(SUM([TotalAmount]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='count customer key' datatype='integer' name='[Calculation_0530273020604416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([customer_key (dim_customers)])' />
      </column>
      <column caption='Return Amount' datatype='real' name='[Calculation_0530273021730817]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_return] = 1 THEN [TotalAmount] ELSE 0 END)' />
      </column>
      <column caption='Actual Sales' datatype='real' name='[Calculation_0530273022234626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [is_return] =0 THEN [TotalAmount] ELSE 0 END)' />
      </column>
      <column caption='Period of day' datatype='string' name='[Calculation_0530273022459907]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [transaction_hour] &gt;= 0 AND [transaction_hour] &lt; 6 THEN &quot;Night&quot; ELSEIF [transaction_hour] &gt;= 6 AND [transaction_hour] &lt; 9 THEN &quot;Early Morning&quot; ELSEIF [transaction_hour] &gt;= 9 AND [transaction_hour] &lt; 12 THEN &quot;Morning&quot; ELSEIF [transaction_hour] &gt;= 12 AND [transaction_hour] &lt; 18 THEN &quot;Afternoon&quot; ELSEIF [transaction_hour] &gt;= 18 AND [transaction_hour] &lt; 22 THEN &quot;Evening&quot; ELSE &quot;Night&quot; END' />
      </column>
      <column caption='hour bins' datatype='string' name='[Calculation_0530273022889988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [transaction_hour] &gt;= 6 AND [transaction_hour] &lt; 8 THEN &quot;6-7&quot; ELSEIF [transaction_hour] &gt;= 8 AND [transaction_hour] &lt; 10 THEN &quot;8-9&quot; ELSEIF [transaction_hour] &gt;= 10 AND [transaction_hour] &lt; 12 THEN &quot;10-11&quot; ELSEIF [transaction_hour] &gt;= 12 AND [transaction_hour] &lt; 14 THEN &quot;12-13&quot; ELSEIF [transaction_hour] &gt;= 14 AND [transaction_hour] &lt; 16 THEN &quot;14-15&quot; ELSEIF [transaction_hour] &gt;= 16 AND [transaction_hour] &lt; 18 THEN &quot;16-17&quot; ELSEIF [transaction_hour] &gt;= 18 AND [transaction_hour] &lt; 20 THEN &quot;18-19&quot; ELSEIF [transaction_hour] &gt;= 20 AND [transaction_hour] &lt; 22 THEN &quot;20-21&quot; ELSE NULL END' />
      </column>
      <column caption='Above average revenue' datatype='boolean' name='[Calculation_0530273042006023]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_0468975230382081]&gt;=WINDOW_AVG([Calculation_0468975230382081])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='count of products' datatype='integer' name='[Calculation_0530273058942984]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Description])' />
      </column>
      <column caption='revenue yoy growth' datatype='real' name='[Calculation_0530273061847049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([TotalAmount])-LOOKUP(SUM([TotalAmount]),-12))/LOOKUP(SUM([TotalAmount]),-12)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
